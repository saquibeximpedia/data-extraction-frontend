# Supabase (fill these in): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key (safe in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only (no NEXT_PUBLIC_ prefix, never reaches the browser): used by the /api routes for
# sign-in checks, countries, months, extraction history, files and accounts.
# Put it in .env.local, which is not committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The private bucket the extraction service writes to (its SUPABASE_BUCKET)
SUPABASE_BUCKET=trade-exports

# Default URL of the extraction service (the Node backend). Each browser can override it in Settings.
NEXT_PUBLIC_EXTRACTION_SERVICE_URL=http://localhost:3000
